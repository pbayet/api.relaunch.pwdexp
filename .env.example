# Copier ce fichier en ".env" à la racine et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel (voir .gitignore).

# "production" = vrais destinataires + tâche quotidienne active.
# Toute autre valeur = tous les mails partent vers BASE_RECIPIENT_EMAIL.
NODE_ENV="development"
PORT="3001"
LOG_LEVEL="debug"

# --------------------------------------------
#               SÉCURITÉ
# --------------------------------------------
# Clé à transmettre dans l'en-tête "x-api-key" pour appeler les routes.
# Générer une valeur longue et aléatoire, ex :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --------------------------------------------
#               LDAP (Active Directory)
# --------------------------------------------
# ldap:// (port 389) obligatoire : la connexion est chiffrée via StartTLS.
LDAP_URL="ldap://xxxxxxxxxxxxxxx:389"
LDAP_DN="CN=xxxxxxxxxxxxxxx"
LDAP_PASSWORD="xxxxxxxxxxxxxxx"
# Certificat de l'AC interne si le certificat du DC n'est pas reconnu.
LDAP_CA_CERT_PATH=""
# Docker uniquement : chemin du certificat DANS le conteneur (déposer le
# fichier dans ./certs). Remplace LDAP_CA_CERT_PATH dans le conteneur.
# DOCKER_LDAP_CA_CERT_PATH="/app/certs/ca.pem"
SEARCH_BASE="OU=Utilisateurs,DC=EXAMPLE,DC=LOCAL"
# DN racine du domaine (lecture de maxPwdAge). Par défaut : composants DC= de SEARCH_BASE.
# LDAP_DOMAIN_DN="DC=EXAMPLE,DC=LOCAL"

# --------------------------------------------
#               SMTP
# --------------------------------------------
HOST="xxxxxxxxxxxxxxx"
EMAIL_PORT="25"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="noreply@example.com"
# Hors production, TOUS les mails partent vers cette adresse (l'objet indique
# le vrai destinataire) — pour ne jamais relancer de vrais utilisateurs en test.
BASE_RECIPIENT_EMAIL="admin@example.com"

# --------------------------------------------
#               RELANCES
# --------------------------------------------
# Relance auto (jours ouvrés, production uniquement) : "false" pour la désactiver.
# PWD_REMINDER_SCHEDULE_ENABLED="true"
# PWD_REMINDER_HOUR="8"
# PWD_REMINDER_MINUTE="0"
# Paliers (jours restants) déclenchant la relance auto.
# PWD_REMINDER_TIERS="15,7,1"
# Comptes expirés relancés chaque jour pendant N jours après l'expiration.
# PWD_REMINDER_EXPIRED_MAX_DAYS="30"
# Seuil par défaut de la relance générale manuelle.
# PWD_REMINDER_DEFAULT_DAYS="15"
# Délai minimal entre deux relances manuelles d'un même compte (minutes).
# PWD_REMINDER_COOLDOWN_MIN="10"
# Envois SMTP simultanés lors d'une relance groupée.
# PWD_REMINDER_CONCURRENCY="3"
# Comptes à ne jamais relancer (comptes de service, boîtes génériques...) :
# emails ou sAMAccountName, séparés par des virgules.
# PWD_REMINDER_EXCLUDE="svc-backup,accueil@example.com"
# Expéditeur (défaut : EMAIL_FROM).
# PWD_REMINDER_FROM="informatique@example.com"
# Nom affiché en tête du mail.
# PWD_REMINDER_APP_NAME="Service informatique"
# Lien du bouton "Changer mon mot de passe" (portail self-service, optionnel).
# PWD_CHANGE_URL=""
# Procédure pour changer son mot de passe en télétravail (lien affiché dans
# le mail, optionnel ; sans valeur, le paragraphe n'apparaît pas).
# PWD_HELP_URL="https://intranet.example.com/procedure-mot-de-passe"
# PWD_HELP_LABEL="Changement de mot de passe à distance"
# Contacts affichés dans l'encart "Besoin d'aide ?" : "Nom|email;Nom|email".
# PWD_REMINDER_CONTACTS="Support informatique|support@example.com"
